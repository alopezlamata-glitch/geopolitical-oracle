# Ollama configuration (all optional — defaults shown)
OLLAMA_URL=http://localhost:11434

# Recommended models (pull with: ollama pull <model>):
#   llama3.1:8b    — fast, good quality (~5GB RAM)
#   llama3.1:70b   — high quality (~40GB RAM)
#   llama3.3:70b   — best quality (~40GB RAM)
#   mistral:7b     — fast alternative
OLLAMA_MODEL=llama3.1:8b

# ACLED conflict event data (optional but highly recommended for conflict questions)
# Register free at: https://developer.acleddata.com
# ACLED_API_KEY=your_key_here
# ACLED_EMAIL=your_email_here
