# Ollama configuration (all optional — defaults shown)
OLLAMA_URL=http://localhost:11434

# Recommended models (pull with: ollama pull <model>):
#   llama3.1:8b    — fast, good quality (~5GB RAM)
#   llama3.1:70b   — high quality (~40GB RAM)
#   llama3.3:70b   — best quality (~40GB RAM)
#   mistral:7b     — fast alternative
OLLAMA_MODEL=llama3.1:8b
